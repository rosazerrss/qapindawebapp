{
  "name": "qapinda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs && node scripts/generate-push-text.mjs",
    "predev": "npm run sync:shared",
    "dev": "next dev",
    "prebuild": "npm run sync:shared",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run sync:shared && tsc --noEmit",
    "pretest": "npm run sync:shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "functions:build": "npm run sync:shared && npm --prefix functions run build",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions": "bash scripts/deploy-functions.sh",
    "deploy": "firebase deploy",
    "emulators": "npm run functions:build && firebase emulators:start",
    "generate:push": "node scripts/generate-push-text.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "deploy:invokers": "bash scripts/grant-invokers.sh"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
